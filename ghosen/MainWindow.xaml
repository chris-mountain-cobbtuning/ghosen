<Window x:Class="ghosen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ghosen.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525" Loaded="Window_Loaded">
  <DockPanel>
    <ComboBox x:Name="selectedParserPlugin" DockPanel.Dock="Top" MaxHeight="34" ItemsSource="{Binding Plugins}" />

    <GroupBox Header="Arb ID Pairs (Request, Response)" DockPanel.Dock="Top" MaxHeight="160">
      <DataGrid x:Name="arbIdGrid" ItemsSource="{Binding ArbIdPairs}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add Pair" Click="AddArbIdPair_Click" />
            <MenuItem Header="Remove Selected" Click="RemoveArbIdPair_Click" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Request ID (hex)" Binding="{Binding RequestIdHex, UpdateSourceTrigger=LostFocus}" Width="*" />
          <DataGridTextColumn Header="Response ID (hex)" Binding="{Binding ResponseIdHex, UpdateSourceTrigger=LostFocus}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <ListView DockPanel.Dock="Bottom" ItemsSource="{Binding Strings}" Drop="DropHandler" AllowDrop="True">
      <ListView.ItemTemplate>
        <DataTemplate>
          <TextBlock x:Name="DataItem" Text="{Binding}" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </DockPanel>
</Window>
